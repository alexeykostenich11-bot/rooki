# ===== Обязательное =====
# Адрес базы PostgreSQL (Timeweb Cloud, раздел «Базы данных»)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Если база требует SSL: true, а если ругается на сертификат: no-verify
DATABASE_SSL=

# Токен Telegram-бота: заявки и уведомления о новых анкетах придут вам в Telegram
TELEGRAM_BOT_TOKEN=

# Адрес сайта, например https://rooki.ru
NEXT_PUBLIC_SITE_URL=

# ===== Фото мастеров =====
# Вариант 1 (рекомендую): S3-хранилище Timeweb. Если все пять значений заданы, фото идут туда.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публичный адрес бакета, например https://имя-бакета.s3.twcstorage.ru
S3_PUBLIC_URL=
# Вариант 2: если S3 не задан, фото лежат на диске сервера в этой папке (диск должен быть постоянным)
UPLOAD_DIR=.uploads

# ===== Необязательно =====
TELEGRAM_CHAT_ID_4=
